# Airtable — read at build time by lib/airtable.ts (see docs/airtable.md).
# Copy this file to .env.local and fill in real values. Everything is optional:
# without these, the site uses the *-fallback.json files in content/.
# .env.local is gitignored; never commit secrets.

AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
LOGOWALL_TABLE=
CONSULTING_PROJECTS_TABLE=
SOCIAL_GOOD_PROJECTS_TABLE=
# Acadev's CLIENT projects. (The DeCal student projects on /decal come from
# content/decal/student-projects.json.) Unset simply hides the Client Projects
# section on /acadev — there is no local fallback for this one.
ACADEV_PROJECTS_TABLE=
EXEC_PROFILES_TABLE=
EXTERNAL_EVENTS_TABLE=
RECRUITMENT_TIMELINE_TABLE=

# Partners page lead form — the table the /api/partner-inquiry route WRITES to
# at request time (unlike the read-only tables above). Needs a token with write
# scope. Table fields: Name, Company, Email, Interest (single select), Message
# (long text), Submitted (created time).
# Without this the form returns 503 and shows its email fallback.
PARTNER_INQUIRIES_TABLE=
